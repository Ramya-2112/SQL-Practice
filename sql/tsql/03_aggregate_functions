/* Multi row functions --------- # Aggreagate function #
They accept multiple rows as input but the output is one single value */
-- count, average, sum, min, max --
--------------------------------------------------------------------------------------------------------------------------------------------------
-- 1. basic aggregation functions
select 
customerid,
count(*) total_orders,
sum(sales) total_sales,
avg(sales) average_sales,
max(sales) highest_sales,
min(sales) lowest_sales
from sales.orders
group by customerid
--2. analysing the scores in table customers
select 
count(*) score,
sum(score) total_score,
avg(score) average_score,
max(score) highest_score,
min(score) lowest_score
from sales.customers;
-- 3. total sales for each product
select
productid,
sum(sales) total_sales
from sales.orders
group by productid;
-- The numbeer of rows in the output is defined by the dimension (productid)
-- 4. moving average and rolling average 
select
orderid,
productid,
orderdate,
sales,
avg(sales)over(partition by productid) normal_average,
avg(sales)over(partition by productid order by orderdate)moving_average,
avg(sales)over(partition by productid order by orderdate rows between current row and 1 following) rolling_average
from sales.orders;
